# Fichiers exclus de l'upload Cloudflare Workers Static Assets.
# Syntaxe gitignore. Empeche la publication de .git (historique complet du
# depot), des fichiers de configuration et des artefacts de build.
# Versionne sur main : un futur deploiement (Workers Builds ou wrangler) ne peut
# plus exposer .git, meme si wrangler.jsonc utilise "assets": { "directory": "." }.

.git
.gitignore
.assetsignore
.wrangler
node_modules
package.json
package-lock.json
wrangler.jsonc
wrangler.toml
worker.js
.env
.env.*
*.map
README*.md
